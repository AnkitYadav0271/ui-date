{
  "name": "ui-date",
  "version": "1.4.1",
  "description": "Lightweight, zero-dependency, locale-aware date formatting and relative time utility for modern UIs.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/AnkitYadav0271/ui-date#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnkitYadav0271/ui-date.git"
  },
  "bugs": {
    "url": "https://github.com/AnkitYadav0271/ui-date/issues"
  },
  "scripts": {
    "build": "tsc && terser dist/index.js -o dist/index.js -c -m",
    "prepublishOnly": "npm run build",
    "test": "vitest"
  },
  "devDependencies": {
    "terser": "^5.49.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "date",
    "ui-date",
    "relative-time",
    "time-ago",
    "intl",
    "i18n",
    "getRelativeTimeParts",
    "zero-dependency",
    "lightweight",
    "dayjs",
    "date-fns"
  ],
  "author": "Ankit Yadav",
  "license": "MIT"
}